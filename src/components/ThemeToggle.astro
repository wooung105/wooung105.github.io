<button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="다크 모드" title="다크 모드로 변경">
  <span class="theme-track" aria-hidden="true">
    <span class="theme-clouds theme-clouds-back"><span></span><span></span><span></span><span></span></span>
    <span class="theme-clouds theme-clouds-front"><span></span><span></span><span></span><span></span></span>
    <span class="theme-stars">
      {[0.6, 0.4, 0.5, 0.35].map((size) => <span class="theme-star"><svg width={`${size}rem`} height={`${size}rem`} viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3 14.6 9.4 21 12 14.6 14.6 12 21 9.4 14.6 3 12 9.4 9.4Z" /></svg></span>)}
    </span>
    <span class="theme-slider">
      <span class="theme-sunlight"><span></span><span></span></span>
      <span class="theme-orb"></span>
    </span>
  </span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    button?.setAttribute('aria-checked', String(theme === 'dark'));
    button?.setAttribute('title', theme === 'dark' ? '라이트 모드로 변경' : '다크 모드로 변경');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#000000' : '#ffffff');
  }
  applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  button?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(theme);
    try { localStorage.setItem('gunwoo-theme', theme); } catch {}
  });
  window.addEventListener('storage', (event) => {
    if (event.key === 'gunwoo-theme' || event.key === null) {
      applyTheme(event.newValue === 'dark' ? 'dark' : 'light');
    }
  });
</script>

<style>
  .theme-toggle{display:grid;place-items:center;width:4rem;height:44px;flex-shrink:0;padding:0;border:0;border-radius:2rem;background:none;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .theme-track{position:relative;display:block;width:4rem;height:2rem;overflow:hidden;border:1px solid #4aa4ff;border-radius:2rem;background:#0263ff;transition:background-color .2s ease-out,border-color .2s ease-out}
  .theme-slider{position:absolute;top:0;left:0;transition:left .2s ease}
  .theme-orb{position:absolute;top:calc(.25rem - 1px);left:calc(.25rem - 1px);width:1.5rem;height:1.5rem;border-radius:50%;background:#fff}
  .theme-orb::before{content:'';position:absolute;left:-10%;top:2%;width:1rem;height:1rem;border-radius:50%;background:#d9effc;transform:scale(0);transition:transform .2s ease,background-color .2s ease}
  .theme-sunlight{position:absolute;transition:opacity .2s ease}
  .theme-sunlight span{position:absolute;border-radius:50%;opacity:.5}
  .theme-sunlight span:first-child{top:calc(-.25rem - 1px);left:calc(-.25rem - 1px);width:2.5rem;height:2.5rem;background:#a2d4f5}
  .theme-sunlight span:last-child{top:-1px;left:-1px;width:2rem;height:2rem;background:#d9effc}
  .theme-clouds{position:absolute;bottom:0;right:0;pointer-events:none;opacity:1;transition:right .2s ease,opacity .2s ease}
  .theme-clouds-back{transition-duration:.3s,.2s}
  .theme-clouds span{position:absolute;border-radius:50%}
  .theme-clouds-back span{background:#b4dcf6}
  .theme-clouds-back span:nth-child(1){width:1.25rem;height:1.25rem;bottom:.75rem;right:-.25rem}
  .theme-clouds-back span:nth-child(2){width:.75rem;height:.75rem;bottom:.25rem;right:.5rem}
  .theme-clouds-back span:nth-child(3){width:1.25rem;height:1.25rem;bottom:-.5rem;right:1rem}
  .theme-clouds-back span:nth-child(4){width:1rem;height:1rem;bottom:.25rem;right:0}
  .theme-clouds-front span{background:#fff}
  .theme-clouds-front span:nth-child(1){width:1.25rem;height:1.25rem;bottom:.5rem;right:-.5rem}
  .theme-clouds-front span:nth-child(2){width:.75rem;height:.75rem;bottom:0;right:.25rem}
  .theme-clouds-front span:nth-child(3){width:1rem;height:1rem;bottom:-.5rem;right:.75rem}
  .theme-clouds-front span:nth-child(4){width:1rem;height:1rem;bottom:0;right:-.25rem}
  .theme-stars{position:absolute;inset:0;left:-2rem;opacity:0;pointer-events:none;transition:left .3s ease,opacity .2s ease}
  .theme-star{position:absolute;animation:theme-twinkle 2s ease-in-out infinite}
  .theme-star svg{display:block}
  .theme-star:nth-child(1){top:.35rem;left:1.5rem;color:#fff}
  .theme-star:nth-child(2){top:.3rem;left:.8rem;color:#ffba85;animation-delay:.3s}
  .theme-star:nth-child(3){bottom:.6rem;left:.5rem;color:#ffe3c7;animation-delay:1s}
  .theme-star:nth-child(4){bottom:.3rem;left:1.3rem;color:#ffba85;animation-delay:1.4s}
  :global([data-theme='dark']) .theme-track{background:#f03420;border-color:#801a08}
  :global([data-theme='dark']) .theme-slider{left:2rem}
  :global([data-theme='dark']) .theme-orb::before{background:#f03420;transform:scale(1)}
  :global([data-theme='dark']) .theme-sunlight{opacity:0}
  :global([data-theme='dark']) .theme-clouds{right:-2rem;opacity:0}
  :global([data-theme='dark']) .theme-stars{left:0;opacity:1}
  @media(hover:hover){
    :global([data-theme='light']) .theme-toggle:hover .theme-clouds-back{right:-.25rem}
    :global([data-theme='light']) .theme-toggle:hover .theme-clouds-front{right:-.2rem}
    :global([data-theme='dark']) .theme-toggle:hover .theme-stars{left:-.2rem}
  }
  @keyframes theme-twinkle{0%,100%{transform:scale(1)}50%{transform:scale(.6)}}
  @media(prefers-reduced-motion:reduce){.theme-toggle *,.theme-toggle *::before{animation:none;transition:none}}
</style>
