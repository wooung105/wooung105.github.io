---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props { title?: string; description?: string }
const { title, description = '배우고 만들며 기록하는 공간, 건우의 개발 블로그입니다.' } = Astro.props;
const pageTitle = title ? `${title} | Wooung` : 'Wooung — 배우고, 만들고, 기록합니다';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" /><link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      let theme = 'light';
      try { if (localStorage.getItem('gunwoo-theme') === 'dark') theme = 'dark'; } catch {}
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#000000' : '#ffffff');
    </script>
  </head>
  <body class:list={[Astro.url.pathname === '/' && 'home-page']}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href="/">Wooung</a>
        <nav aria-label="주 메뉴"><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>HOME</a><a href="/resume/" aria-current={Astro.url.pathname.replace(/\/$/, '') === '/resume' ? 'page' : undefined}>Resume</a><a href="/series/" aria-current={Astro.url.pathname.startsWith('/series/') ? 'page' : undefined}>Series</a><a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') || Astro.url.pathname.startsWith('/posts/') ? 'page' : undefined}>Blog</a></nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="shell footer-inner"><div><a class="footer-brand" href="/">Wooung</a><p>배우고, 만들고, 기록합니다.</p></div><div class="footer-right"><a href="https://github.com/wooung105" target="_blank" rel="noopener noreferrer">GitHub ↗</a><p>© {new Date().getFullYear()} wooung105</p></div></div></footer>
  </body>
</html>
