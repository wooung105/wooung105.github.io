---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getSeries } from '../../lib/posts';
const series = await getSeries();
---
<BaseLayout title="Series" description="이어지는 글을 모아 둔 시리즈 목록입니다.">
  <div class="series-page shell">
    <header class="series-heading">
      <p class="eyebrow">SERIES</p>
      <h1>시리즈</h1>
      <p>같은 주제의 글 모음</p>
    </header>
    {series.length ? <div class="series-grid">
      {series.map((item, index) => {
        const first = item.posts[0];
        const last = item.posts[item.posts.length - 1];
        return <a class="series-card" href={`/series/${encodeURIComponent(item.name)}/`}>
          <div class="series-cover" aria-hidden="true"><span>SERIES / {String(index + 1).padStart(2, '0')}</span><strong>{item.name}</strong><span>{item.posts.length} {item.posts.length === 1 ? 'POST' : 'POSTS'}</span></div>
          <div class="series-card-content"><h2>{item.name}</h2><span class="series-count">{item.posts.length}개의 글</span><p>{first.data.title}</p><span class="series-date">{formatDate(first.data.date)}{first.data.date.valueOf() !== last.data.date.valueOf() && ` — ${formatDate(last.data.date)}`}</span></div>
        </a>;
      })}
    </div> : <p class="series-empty">아직 작성된 시리즈가 없습니다.</p>}
  </div>
</BaseLayout>
<style>
  .series-page{padding-top:72px;padding-bottom:100px}
  .series-heading{margin-bottom:42px}
  .series-heading h1{margin:16px 0;font-size:clamp(36px,4vw,48px);line-height:1.3;letter-spacing:-.05em}
  .series-heading h1 span{color:var(--accent)}
  .series-heading>p:last-child{margin:0;color:var(--muted);font-size:15px;line-height:1.8}
  .series-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px 24px}
  .series-card{display:block;min-width:0}
  .series-cover{aspect-ratio:16/9;display:flex;flex-direction:column;justify-content:space-between;gap:12px;overflow:hidden;padding:22px;background:var(--cover);color:var(--cover-ink)}
  .series-cover span{font-size:10px;font-weight:700;letter-spacing:.08em}
  .series-cover strong{font-size:clamp(20px,2vw,26px);line-height:1.3;letter-spacing:-.04em;overflow-wrap:anywhere}
  .series-card-content{padding-top:16px}
  .series-card-content h2{display:inline;font-size:18px;line-height:1.5;letter-spacing:-.03em;overflow-wrap:anywhere}
  .series-card:hover h2{color:var(--accent)}
  .series-count{margin-left:8px;color:var(--accent);font-size:12px;font-weight:700;white-space:nowrap}
  .series-card-content p{margin:8px 0;color:var(--muted);font-size:13px;line-height:1.6}
  .series-date{color:var(--muted);font-size:12px}
  .series-empty{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:14px}
  @media(max-width:760px){.series-page{padding-top:54px;padding-bottom:70px}.series-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:500px){.series-grid{grid-template-columns:1fr}.series-heading{margin-bottom:30px}}
</style>
