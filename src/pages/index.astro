---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { Image } from 'astro:assets';
import viscacha from '../assets/viscacha.png';
import { getPublishedPosts, getSeries } from '../lib/posts';
const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const series = await getSeries();
---
<BaseLayout>
  <section class="home-series shell" aria-labelledby="home-series-title">
    <div class="home-series-heading"><h2 id="home-series-title">시리즈</h2><a href="/series/">시리즈 모아보기 ↗</a></div>
    {series.length ? <div class="home-series-grid">{series.slice(0, 3).map((item) => <a class="home-series-item" href={`/series/${encodeURIComponent(item.name)}/`}><span class="home-series-cover" aria-hidden="true">{item.name}</span><span class="home-series-info"><strong>{item.name}</strong><span>{item.posts.length}개의 글</span></span><span aria-hidden="true">→</span></a>)}</div> : <p class="home-series-empty">아직 작성된 시리즈가 없습니다.</p>}
  </section>
  <div class="content-grid shell">
    <section class="journal" id="posts" aria-labelledby="posts-title">
      <div class="section-heading"><div><p class="eyebrow">THE JOURNAL</p><h2 id="posts-title">최근 기록 <span class="count">{posts.length}</span></h2></div><a class="subtle-link" href="#topics">주제 살펴보기 ↗</a></div>
      <div class="topic-tabs"><a class="active" href="/#posts">전체 기록</a>{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div>
      <div class="search-box"><label for="post-search">글 검색</label><input id="post-search" type="search" placeholder="제목, 내용 또는 태그 검색" autocomplete="off" /></div>
      <PostList posts={posts} /><p class="empty-state search-empty" hidden>검색 결과가 없습니다.</p>
    </section>
    <aside class="sidebar" aria-label="블로그 정보와 주제">
      <section class="profile-card"><div class="profile-heading"><div class="profile-avatar"><Image src={viscacha} width={180} height={180} alt="졸린 비스카차 캐릭터" /></div><div><h2>wooung105</h2><p>김건우</p></div></div><p>고려대학교(세종)<br />인공지능사이버보안학과<br />화이트햇스쿨 4기</p><a href="https://github.com/wooung105" target="_blank" rel="noopener noreferrer">GitHub 프로필 ↗</a></section>
      <section class="sidebar-topics" id="topics"><div class="sidebar-heading"><h2>주제별 기록</h2><span>{tags.length}</span></div>{tags.length ? <ul>{tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}><span>{tag}</span><span>{posts.filter((post) => post.data.tags.includes(tag)).length}</span></a></li>)}</ul> : <p>아직 주제가 없습니다.</p>}</section>
    </aside>
  </div>
  <script>
    const search = document.querySelector<HTMLInputElement>('#post-search');
    const rows = [...document.querySelectorAll<HTMLElement>('.post-row')];
    const empty = document.querySelector<HTMLElement>('.search-empty');
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const match = (row.dataset.search || '').includes(query);
        row.hidden = !match;
        if (match) visible++;
      }
      if (empty) empty.hidden = visible > 0 || rows.length === 0;
    });
  </script>
</BaseLayout>
